  phantomComments:
  - phantom: 2
    requiredSync: 0
    comment: "\u0417\u043D\u0430\u043A \u043D\u0430 \u0435\u0433\u043E \u043F\u043B\u043E\u0442\u0438
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0433\u0440\u043E\u043C\u0447\u0435
      \u0441\u043B\u043E\u0432. \u041E\u043D \u0432\u0441\u0442\u0430\u043B \u043D\u0430
      \u043F\u0443\u0442\u0438 \u0443 \u041A\u043E\u0440\u043E\u043B\u044F, \u0438
      \u041A\u043E\u0440\u043E\u043B\u044C \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043C\u0430\u0445\u043D\u0443\u043B
      \u0435\u0433\u043E. \u041E\u043D \u043C\u0435\u0448\u0430\u043B \u0438\u043C...
      \u0438 \u0437\u0430 \u044D\u0442\u043E \u0441\u0442\u0430\u043B \u0447\u0430\u0441\u0442\u044C\u044E
      \u0438\u0445 \u043A\u0440\u043E\u0432\u0430\u0432\u043E\u0433\u043E \u0443\u0437\u043E\u0440\u0430\xBB."
