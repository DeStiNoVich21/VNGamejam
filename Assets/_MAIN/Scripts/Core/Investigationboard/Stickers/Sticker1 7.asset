  title: "\u041A\u043B\u0435\u0439\u043C\u043E"
  tag: 4
  bodyText: "\u041F\u0440\u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435 \u0441\u043F\u0438\u043D\u044B
    \u0443\u0431\u0438\u0442\u043E\u0433\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E
    \u0432\u044B\u0436\u0436\u0435\u043D\u043D\u043E\u0435 \u0438\u043B\u0438 \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u043E\u0435
    \u043A\u043B\u0435\u0439\u043C\u043E \u2014 \u0441\u0438\u043C\u0432\u043E\u043B
    \u041A\u0443\u043B\u044C\u0442\u0430. \u0414\u0438\u043B\u0435\u0440 \u0431\u044B\u043B
    \u043F\u043E\u043C\u0435\u0447\u0435\u043D \u043A\u0430\u043A \u0432\u0440\u0430\u0433,
    \u043E\u043D \u0441\u0442\u0430\u043B \u0438\u043C \u043C\u0435\u0448\u0430\u0442\u044C"
  icon: {fileID: 4871413175895638335, guid: acdc935a31cb2b84d95b12e8e7825d87, type: 3}
  isPhantomFact: 0
