  requiredSync: 25
  phantomComments:
  - phantom: 0
    requiredSync: 0
    comment: "\xAB\u041E\u043D \u043D\u0435 \u0431\u044B\u043B \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u043C \u0441\u043C\u0435\u0440\u0442\u044C\u044E.
      \u041E\u043D \u0431\u044B\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0445\u043E\u0442\u0435\u043B \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u043E\u0448\u0438\u0431\u043A\u0438 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E.
      \u0415\u0433\u043E \u0443\u0431\u0438\u043B\u0438 \u0437\u0430 \u043D\u0430\u0434\u0435\u0436\u0434\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043E\u043D \u043D\u0435 \u0443\u0441\u043F\u0435\u043B
      \u0432\u043E\u043F\u043B\u043E\u0442\u0438\u0442\u044C\xBB."
