  title: "\u0427\u0438\u0441\u0442\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430
    (\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0431\u043E\u0440\u044C\u0431\u044B)"
  tag: 5
  bodyText: "\u0414\u0438\u043B\u0430\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
    \u0447\u0442\u043E \u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \xAB\u043D\u0430\u0448\u043B\u0438
    \u0435\u0433\u043E\xBB. \u0415\u0441\u043B\u0438 \u0431\u044B \u0431\u044B\u043B\u0430
    \u0431\u043E\u0439\u043D\u044F, \u043A\u0430\u043A \u0432\u0447\u0435\u0440\u0430,
    \u043E\u0431 \u044D\u0442\u043E\u043C \u0431\u044B \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u043B\u0438.
    \u0417\u043D\u0430\u0447\u0438\u0442, \u0443\u0431\u0438\u0442 \u0442\u0438\u0445\u043E/\u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E."
