  conclusions:
  - conclusionId: Cult
    title: "\u0422\u0440\u0430\u043A\u0442\u043E\u0432\u043A\u0430"
    summaryText: "\u0414\u0438\u043B\u0435\u0440 \u043D\u0430\u0447\u0430\u043B \u043C\u0435\u0448\u0430\u0442\u044C
      \u041A\u0443\u043B\u044C\u0442\u0443 (\u0421\u0442\u0438\u0433\u043C\u0435).
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u043D \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0442\u044C
      \xAB\u043E\u0441\u043E\u0431\u0443\u044E\xBB \u0434\u0443\u0440\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043D\u0443\u0436\u043D\u0430 \u0431\u044B\u043B\u0430 \u043A\u0443\u043B\u044C\u0442\u0438\u0441\u0442\u0430\u043C
      \u0434\u043B\u044F \u0438\u0445 \u0440\u0438\u0442\u0443\u0430\u043B\u043E\u0432
      \u0438\u043B\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F \u043D\u0430\u0434
      \u0440\u0430\u0437\u0443\u043C\u043E\u043C \u043B\u044E\u0434\u0435\u0439.
      \u0415\u0433\u043E \u0443\u0441\u0442\u0440\u0430\u043D\u0438\u043B\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043D\u0435 \u043C\u0435\u0448\u0430\u043B
      \xAB\u0432\u0435\u043B\u0438\u043A\u043E\u043C\u0443 \u043F\u0440\u0438\u0448\u0435\u0441\u0442\u0432\u0438\u044E\xBB"
    requiredStickerIds:
    - message
    - Mark
    syncBonuses: []
    setsFlag: 
  - conclusionId: Order
    title: "\u0422\u0440\u0430\u043A\u0442\u043E\u0432\u043A\u0430"
    summaryText: "\u042D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438
      \u043D\u0435 \u0431\u0430\u043D\u0434\u0438\u0442\u044B. \u041F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044B
      \u0443\u0441\u0442\u0440\u0430\u043D\u0438\u043B\u0438 \u0434\u0438\u043B\u0435\u0440\u0430,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043E\u043D \u0441\u0442\u0430\u043B
      \xAB\u0448\u0443\u043C\u043D\u044B\u043C\xBB \u0438 \u043C\u043E\u0433 \u0432\u044B\u0432\u0435\u0441\u0442\u0438
      \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
      \u043A\u0443\u0440\u0430\u0442\u043E\u0440\u043E\u0432 \u0438\u0437 \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430."
    requiredStickerIds:
    - Wounds
    - message
    syncBonuses: []
    setsFlag: 
  - conclusionId: Zenith
    title: "\u0422\u0440\u0430\u043A\u0442\u043E\u0432\u043A\u0430"
    summaryText: "\u0414\u0438\u043B\u0435\u0440 \u0445\u043E\u0442\u0435\u043B \u0443\u0439\u0442\u0438.
      \u041E\u043D \u043A\u043E\u043F\u0438\u043B \u0434\u0435\u043D\u044C\u0433\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0431\u043B\u0438\u0437\u043A\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438 \u0441\u0431\u0435\u0436\u0430\u0442\u044C
      \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u0430\u0434\u0430. \u0415\u0433\u043E
      \u0443\u0431\u0438\u043B\u0438 \u0432 \u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u0431\u044B\u043B \u0433\u043E\u0442\u043E\u0432
      \u0441\u0434\u0430\u0442\u044C \u0432\u0441\u0435\u0445 \u0440\u0430\u0434\u0438
      \u0448\u0430\u043D\u0441\u0430 \u043D\u0430 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0443\u044E
      \u0436\u0438\u0437\u043D\u044C."
    requiredStickerIds:
    - message
    - Photo
    syncBonuses: []
    setsFlag: 
  - conclusionId: Neutral
    title: "\u0422\u0440\u0430\u043A\u0442\u043E\u0432\u043A\u0430"
    summaryText: "\u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0446\u0438\u044F.
      \u0414\u0438\u043B\u0435\u0440 \u043C\u0435\u0448\u0430\u043B \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0435
      \u043D\u043E\u0432\u044B\u043C \u0432\u0438\u0434\u043E\u043C \u0434\u0443\u0440\u0438
      \u043D\u0430 \u0441\u0432\u043E\u0435\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438.
      \u0415\u0433\u043E \u043A\u043E\u043A\u043D\u0443\u043B\u0438 \u043C\u0435\u0441\u0442\u043D\u044B\u0435
      \u0431\u0430\u043D\u0434\u0438\u0442\u044B, \u0447\u0442\u043E\u0431\u044B
      \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0440\u044B\u043D\u043E\u043A
      \u0434\u043B\u044F \u0431\u043E\u043B\u0435\u0435 \u0434\u0435\u0448\u0435\u0432\u043E\u0433\u043E
      \u0438 \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u0442\u043E\u0432\u0430\u0440\u0430,
      \u043D\u0435 \u0437\u0430\u0431\u043E\u0442\u044F\u0441\u044C \u043E \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F\u0445."
    requiredStickerIds:
    - Packet
    - message
    syncBonuses: []
    setsFlag: 
